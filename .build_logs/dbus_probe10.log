     2	
     3	# SPDX-FileCopyrightText: 2024 UnionTech Software Technology Co., Ltd.
     4	#
     5	# SPDX-License-Identifier: GPL-3.0-or-later
     6	
     7	# qurl::toPercentEncoding的加密规则
     8	# When Chinese special characters are mixed, only the ascall character set is used for encoding. 
     9	# When Chinese characters and special characters are mixed, encoding errors occur, 
    10	# resulting in the inability to open some directories with special characters. 
    11	# Here, utf-8 multi-byte encoding is used.
    12	urlencode() {
    13	    local input="${1}"
    14	    local output=""
    15	    local char
    16	
    17	   
    18	    while IFS= read -r -n1 char; do
    19	        # Convert the character into bytes
    20	        if [[ "$char" =~ [a-zA-Z0-9\-\_\.\~] ]]; then
    21	            # If the character is unreserved, append as is
    22	            output+="$char"
    23	        else
    24	            # Handle multi-byte characters
    25	            local bytes
    26	            bytes=$(printf "%s" "$char" | od -An -tx1 | tr -d ' \n')
    27	            while [[ "$bytes" != "" ]]; do
    28	                output+="%${bytes:0:2}"  # Take the first byte
    29	                bytes="${bytes:2}"      # Remove the first byte
    30	            done
    31	        fi
    32	    done < <(printf "%s" "$input")
    33	
    34	    echo "$output"
    35	}
    36	
    37	args=""
    38	argsOrigin=""
    39	current_path=$(pwd)
    40	isDbus="true"
    41	for arg in "$@"; do
    42	    # .\ ./ \ .. \ ../ 这几个符号在传入dbus后丢失路径，在这里进行转换
    43	    if [[ $arg == "." ]] || [[ $arg == ".." ]] || [[ $arg == *"/." ]] || [[ $arg == *"/.." ]] || [[ $arg =~ "./" ]] || [[ $arg =~ "../" ]] || [[ $arg =~ "~/" ]]; then
    44	        name=${arg##*/}
    45	        path=${arg%/*}"/"
    46	        if [[ $name == "." ]] || [[ $name == ".." ]]; then
    47	            name=""
    48	            path=$path$name
    49	        fi
    50	        if [[ $path =~ "~/" ]]; then
    51	            cd ~/
    52	            home_path=$(pwd)
    53	            path=$(echo "$path" | sed "s|~/|$home_path/|g")
    54	            cd $current_path
    55	        fi
    56	        cd "$path"
    57	        path=$(pwd)"/"
    58	        cd $current_path
    59	        absolute_path=$path$name
    60	        arg=$absolute_path
    61	    fi
    62	
    63	    # 对不是-开头的参数进行qurl::toPercentEncoding加密
    64	    if [[ "$arg:0:1" =~ "-" ]]; then
    65	        tmpArg=$(urlencode "$arg")
    66	        # 对于\n加密为了%5cn，替换为正确的%0A
    67	        tmpArg=$(echo "$tmpArg" | sed 's/%5cn/%0A/g')
    68	        argsOrigin+="$tmpArg "
    69	    else
    70	        argsOrigin+="$arg "
    71	    fi
    72	
    73	    # array:string:"$args"中','是切分符号，所以传入dbus是要被切分
    74	    if [[ $arg == "-h" ]] || [[ $arg == "--help" ]] || [[ $arg == "--help-all" ]] || [[ $arg == "-v" ]] || [[ $arg == "--version" ]] || [[ $arg == *","* ]]; then
    75	        isDbus="false"
    76	    fi
    77	
    78	    args+="$arg,"
    79	done
    80	args=${args%,}
    81	
    82	if [[ $isDbus == "false" ]]; then
    83	    exec file-manager.sh "$argsOrigin"
    84	    return;
    85	fi
    86	
    87	dbus-send --print-reply --dest=org.freedesktop.FileManager1 /org/freedesktop/FileManager1 org.freedesktop.FileManager1.Open array:string:"$args"
    88	
    89	if [ $? -ne 0 ]; then
    90	    echo "dbus call failed"
    91	    exec file-manager.sh "$argsOrigin"
    92	fi
