#!/usr/bin/env python3
"""abzOS Control Center -- a quick-settings popup (volume, brightness,
Wi-Fi, Bluetooth, dark style, do-not-disturb, power mode, night light,
airplane mode) plus screenshot/settings/lock/power shortcuts.

Launched fresh each time from the top panel's genmon plugin; it is not a
background daemon, so a crash here never takes real system notifications
or networking down with it -- each toggle just shells out to the same
tools (nmcli, bluetoothctl, pactl, ...) a user would run by hand.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

from abzos_ui_common import (  # noqa: E402
    enable_transparency,
    has_cmd,
    load_css,
    position_top_right,
    run,
    run_out,
)

PANEL_WIDTH = 340


def icon_button(icon_name, tooltip, on_click):
    btn = Gtk.Button()
    btn.get_style_context().add_class("abzos-icon-btn")
    img = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.SMALL_TOOLBAR)
    btn.add(img)
    btn.set_tooltip_text(tooltip)
    btn.connect("clicked", on_click)
    return btn


class Pill(Gtk.Button):
    def __init__(self, icon_name, title, get_subtitle=None, wide=False):
        super().__init__()
        self.get_style_context().add_class("abzos-pill")
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        box.set_halign(Gtk.Align.START)
        img = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.LARGE_TOOLBAR)
        box.pack_start(img, False, False, 0)
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.title_lbl = Gtk.Label(label=title, xalign=0)
        self.title_lbl.get_style_context().add_class("abzos-title")
        vbox.pack_start(self.title_lbl, False, False, 0)
        self.sub_lbl = Gtk.Label(xalign=0)
        self.sub_lbl.get_style_context().add_class("abzos-sub")
        vbox.pack_start(self.sub_lbl, False, False, 0)
        box.pack_start(vbox, True, True, 0)
        self.add(box)
        self._get_subtitle = get_subtitle
        if wide:
            self.set_hexpand(True)
        self.refresh()

    def refresh(self):
        if self._get_subtitle:
            active, sub = self._get_subtitle()
            self.sub_lbl.set_text(sub)
            self.sub_lbl.set_visible(bool(sub))
            ctx = self.get_style_context()
            if active:
                ctx.add_class("active")
            else:
                ctx.remove_class("active")


# --- state probes -----------------------------------------------------

def wifi_state():
    out = run_out(["nmcli", "-t", "-f", "WIFI", "radio"])
    on = out.strip().lower() == "enabled"
    if on:
        ssid = run_out(["nmcli", "-t", "-f", "active,ssid", "dev", "wifi"])
        for line in ssid.splitlines():
            if line.startswith("yes:"):
                return True, line.split(":", 1)[1] or "Connected"
        return True, "On"
    return False, "Off"


def bt_state():
    out = run_out(["bluetoothctl", "show"])
    on = "Powered: yes" in out
    return on, "On" if on else "Off"


def dnd_state():
    out = run_out([
        "xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb",
    ])
    on = out.strip().lower() == "true"
    return on, "On" if on else "Off"


def dark_state():
    theme = run_out(["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName"])
    on = "dracula" in theme.lower() or "dark" in theme.lower()
    return on, "On" if on else "Off"


def airplane_state():
    out = run_out(["rfkill", "list"])
    blocked = out.count("Soft blocked: yes") > 0 and "Soft blocked: no" not in out
    return blocked, "On" if blocked else "Off"


NIGHT_LIGHT_PID_FILE = os.path.expanduser("~/.cache/abzos-night-light.pid")


def night_light_state():
    if os.path.exists(NIGHT_LIGHT_PID_FILE):
        try:
            pid = int(open(NIGHT_LIGHT_PID_FILE).read().strip())
            os.kill(pid, 0)
            return True, "On"
        except Exception:
            pass
    return False, "Off"


def power_mode_state():
    out = run_out([
        "xfconf-query", "-c", "xfce4-power-manager", "-p", "/xfce4-power-manager/power-save-on-battery",
    ])
    saver = out.strip().lower() == "true"
    return saver, "Power Saver" if saver else "Balanced"


# --- actions ------------------------------------------------------------

def toggle_wifi(_btn):
    on, _ = wifi_state()
    run(["nmcli", "radio", "wifi", "off" if on else "on"])


def toggle_bt(_btn):
    on, _ = bt_state()
    run(["bluetoothctl", "power", "off" if on else "on"])


def toggle_dnd(_btn):
    on, _ = dnd_state()
    run(["xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb", "-n", "-t", "bool", "-s", "false" if on else "true"])


def toggle_dark(_btn):
    on, _ = dark_state()
    if on:
        run(["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName", "-s", "Adwaita"])
        run(["xfconf-query", "-c", "xsettings", "-p", "/Net/IconThemeName", "-s", "Yaru"])
        run(["xfconf-query", "-c", "xfwm4", "-p", "/general/theme", "-s", "Default"])
    else:
        run(["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName", "-s", "Ant-Dracula"])
        run(["xfconf-query", "-c", "xsettings", "-p", "/Net/IconThemeName", "-s", "Yaru-dark"])
        run(["xfconf-query", "-c", "xfwm4", "-p", "/general/theme", "-s", "Ant-Dracula"])


def toggle_airplane(_btn):
    on, _ = airplane_state()
    if on:
        run(["rfkill", "unblock", "all"])
    else:
        run(["rfkill", "block", "all"])


def toggle_night_light(_btn):
    on, _ = night_light_state()
    if on:
        try:
            pid = int(open(NIGHT_LIGHT_PID_FILE).read().strip())
            os.kill(pid, 15)
        except Exception:
            pass
        try:
            os.remove(NIGHT_LIGHT_PID_FILE)
        except Exception:
            pass
        run(["redshift", "-x"])
    elif has_cmd("redshift"):
        os.makedirs(os.path.dirname(NIGHT_LIGHT_PID_FILE), exist_ok=True)
        proc = __import__("subprocess").Popen(
            ["redshift", "-O", "4000"], stdout=__import__("subprocess").DEVNULL, stderr=__import__("subprocess").DEVNULL
        )
        with open(NIGHT_LIGHT_PID_FILE, "w") as f:
            f.write(str(proc.pid))


def toggle_power_mode(_btn):
    saver, _ = power_mode_state()
    run([
        "xfconf-query", "-c", "xfce4-power-manager", "-p", "/xfce4-power-manager/power-save-on-battery",
        "-n", "-t", "bool", "-s", "false" if saver else "true",
    ])


def set_volume(scale):
    val = int(scale.get_value())
    run(["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{val}%"])


def get_volume():
    out = run_out(["pactl", "get-sink-volume", "@DEFAULT_SINK@"])
    for tok in out.split():
        if tok.endswith("%"):
            try:
                return int(tok[:-1])
            except ValueError:
                pass
    return 50


def set_brightness(scale):
    val = int(scale.get_value())
    if has_cmd("brightnessctl"):
        run(["brightnessctl", "set", f"{val}%"])
    else:
        out = run_out(["bash", "-c", "xrandr --listmonitors | awk 'NR>1{print $NF; exit}'"])
        if out:
            run(["xrandr", "--output", out, "--brightness", str(max(0.1, val / 100))])


def get_brightness():
    if has_cmd("brightnessctl"):
        out = run_out(["brightnessctl", "get"])
        maxout = run_out(["brightnessctl", "max"])
        try:
            return int(int(out) / int(maxout) * 100)
        except Exception:
            pass
    return 80


def battery_info():
    base = "/sys/class/power_supply"
    if not os.path.isdir(base):
        return None
    for name in os.listdir(base):
        if name.startswith("BAT"):
            try:
                cap = open(f"{base}/{name}/capacity").read().strip()
                status = open(f"{base}/{name}/status").read().strip()
                return cap, status
            except Exception:
                continue
    return None


def main():
    load_css()
    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_decorated(False)
    win.set_skip_taskbar_hint(True)
    win.set_skip_pager_hint(True)
    win.set_keep_above(True)
    win.get_style_context().add_class("abzos-panel")
    enable_transparency(win)
    win.set_default_size(PANEL_WIDTH, -1)

    card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    card.get_style_context().add_class("abzos-card")
    win.add(card)

    # Top row: battery + quick action icons
    top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    bat = battery_info()
    if bat:
        cap, status = bat
        charging = "⚡" if status == "Charging" else ""
        bat_btn = Gtk.Button(label=f"{charging}{cap}%")
        bat_btn.get_style_context().add_class("abzos-battery")
        bat_btn.set_sensitive(False)
        top.pack_start(bat_btn, False, False, 0)
    spacer = Gtk.Box()
    top.pack_start(spacer, True, True, 0)
    top.pack_start(icon_button("camera-photo-symbolic", "Screenshot", lambda b: (run(["xfce4-screenshooter"]), win.close())), False, False, 0)
    top.pack_start(icon_button("preferences-system-symbolic", "Settings", lambda b: (run(["xfce4-settings-manager"]), win.close())), False, False, 0)
    top.pack_start(icon_button("system-lock-screen-symbolic", "Lock", lambda b: (run(["light-locker-command", "-l"]) if has_cmd("light-locker-command") else run(["xflock4"]), win.close())), False, False, 0)
    top.pack_start(icon_button("system-shutdown-symbolic", "Power", lambda b: (run(["xfce4-session-logout"]), win.close())), False, False, 0)
    card.pack_start(top, False, False, 0)

    # Volume slider
    vol_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
    vol_row.get_style_context().add_class("abzos-row")
    vol_row.pack_start(Gtk.Image.new_from_icon_name("audio-volume-high-symbolic", Gtk.IconSize.SMALL_TOOLBAR), False, False, 0)
    vol_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
    vol_scale.get_style_context().add_class("abzos-slider")
    vol_scale.set_draw_value(False)
    vol_scale.set_value(get_volume())
    vol_scale.connect("value-changed", set_volume)
    vol_row.pack_start(vol_scale, True, True, 0)
    card.pack_start(vol_row, False, False, 0)

    # Brightness slider
    bri_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
    bri_row.get_style_context().add_class("abzos-row")
    bri_row.pack_start(Gtk.Image.new_from_icon_name("display-brightness-symbolic", Gtk.IconSize.SMALL_TOOLBAR), False, False, 0)
    bri_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
    bri_scale.get_style_context().add_class("abzos-slider")
    bri_scale.set_draw_value(False)
    bri_scale.set_value(get_brightness())
    bri_scale.connect("value-changed", set_brightness)
    bri_row.pack_start(bri_scale, True, True, 0)
    card.pack_start(bri_row, False, False, 0)

    # Toggle grid (2 columns)
    grid = Gtk.Grid(column_spacing=8, row_spacing=8, column_homogeneous=True)

    wifi_pill = Pill("network-wireless-symbolic", "Wi-Fi", wifi_state)
    wifi_pill.connect("clicked", lambda b: (toggle_wifi(b), GLib.timeout_add(400, lambda: (wifi_pill.refresh(), False)[1])))
    grid.attach(wifi_pill, 0, 0, 1, 1)

    bt_pill = Pill("bluetooth-symbolic", "Bluetooth", bt_state)
    bt_pill.connect("clicked", lambda b: (toggle_bt(b), GLib.timeout_add(400, lambda: (bt_pill.refresh(), False)[1])))
    grid.attach(bt_pill, 1, 0, 1, 1)

    pm_pill = Pill("battery-good-symbolic", "Power Mode", power_mode_state)
    pm_pill.connect("clicked", lambda b: (toggle_power_mode(b), pm_pill.refresh()))
    grid.attach(pm_pill, 0, 1, 1, 1)

    nl_pill = Pill("weather-clear-night-symbolic", "Night Light", night_light_state)
    nl_pill.connect("clicked", lambda b: (toggle_night_light(b), nl_pill.refresh()))
    grid.attach(nl_pill, 1, 1, 1, 1)

    dark_pill = Pill("weather-clear-night-symbolic", "Dark Style", dark_state)
    dark_pill.connect("clicked", lambda b: (toggle_dark(b), GLib.timeout_add(300, lambda: (dark_pill.refresh(), False)[1])))
    grid.attach(dark_pill, 0, 2, 1, 1)

    dnd_pill = Pill("notifications-disabled-symbolic", "Do Not Disturb", dnd_state)
    dnd_pill.connect("clicked", lambda b: (toggle_dnd(b), dnd_pill.refresh()))
    grid.attach(dnd_pill, 1, 2, 1, 1)

    card.pack_start(grid, False, False, 0)

    air_pill = Pill("airplane-mode-symbolic", "Airplane Mode", airplane_state, wide=True)
    air_pill.connect("clicked", lambda b: (toggle_airplane(b), GLib.timeout_add(400, lambda: (air_pill.refresh(), False)[1])))
    card.pack_start(air_pill, False, False, 0)

    win.show_all()
    win.get_window().set_override_redirect(False)
    position_top_right(win, PANEL_WIDTH + 32)

    # Close when it loses focus, like a normal popover
    win.connect("focus-out-event", lambda w, e: win.close())

    Gtk.main()


if __name__ == "__main__":
    main()
