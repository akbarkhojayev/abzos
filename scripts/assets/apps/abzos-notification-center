#!/usr/bin/env python3
"""abzOS Notification Center -- recent notification history + a calendar,
opened by clicking the clock in the top panel (matches the macOS/GNOME
pattern of clock -> notifications+calendar)."""
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk  # noqa: E402

from abzos_ui_common import enable_transparency, load_css, position_top_right  # noqa: E402

LOG_PATH = os.path.expanduser("~/.local/share/abzos/notifications.json")
PANEL_WIDTH = 560


def relative_time(ts):
    delta = time.time() - ts
    if delta < 60:
        return "just now"
    if delta < 3600:
        return f"{int(delta // 60)}m ago"
    if delta < 86400:
        return f"{int(delta // 3600)}h ago"
    days = int(delta // 86400)
    return f"{days} day{'s' if days != 1 else ''} ago"


def load_entries():
    try:
        with open(LOG_PATH) as f:
            return list(reversed(json.load(f)))
    except Exception:
        return []


def build_notification_row(entry):
    row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    row.get_style_context().add_class("abzos-card")
    row.set_margin_bottom(8)

    header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    icon_name = entry.get("icon") or "dialog-information-symbolic"
    img = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.SMALL_TOOLBAR)
    header.pack_start(img, False, False, 0)
    title = Gtk.Label(label=entry.get("app_name", "System"), xalign=0)
    title.get_style_context().add_class("abzos-title")
    header.pack_start(title, True, True, 0)
    when = Gtk.Label(label=relative_time(entry.get("ts", time.time())))
    when.get_style_context().add_class("abzos-sub")
    header.pack_start(when, False, False, 0)
    row.pack_start(header, False, False, 0)

    if entry.get("summary"):
        summary = Gtk.Label(label=entry["summary"], xalign=0)
        summary.get_style_context().add_class("abzos-title")
        summary.set_line_wrap(True)
        row.pack_start(summary, False, False, 0)
    if entry.get("body"):
        body = Gtk.Label(label=entry["body"], xalign=0)
        body.get_style_context().add_class("abzos-sub")
        body.set_line_wrap(True)
        row.pack_start(body, False, False, 0)
    return row


def clear_log(_btn, listbox_container):
    try:
        os.remove(LOG_PATH)
    except Exception:
        pass
    for child in list(listbox_container.get_children()):
        listbox_container.remove(child)
    placeholder = Gtk.Label(label="No notifications")
    placeholder.get_style_context().add_class("abzos-sub")
    placeholder.set_margin_top(24)
    listbox_container.pack_start(placeholder, False, False, 0)
    listbox_container.show_all()


def main():
    load_css()
    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_decorated(False)
    win.set_skip_taskbar_hint(True)
    win.set_skip_pager_hint(True)
    win.set_keep_above(True)
    win.get_style_context().add_class("abzos-panel")
    enable_transparency(win)
    win.set_default_size(PANEL_WIDTH, 420)

    outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
    outer.get_style_context().add_class("abzos-card")
    win.add(outer)

    # Left: notification history
    left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    left.set_size_request(int(PANEL_WIDTH * 0.5), -1)

    scroller = Gtk.ScrolledWindow()
    scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    scroller.set_vexpand(True)
    list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
    entries = load_entries()
    if entries:
        for entry in entries:
            list_box.pack_start(build_notification_row(entry), False, False, 0)
    else:
        placeholder = Gtk.Label(label="No notifications")
        placeholder.get_style_context().add_class("abzos-sub")
        placeholder.set_margin_top(24)
        list_box.pack_start(placeholder, False, False, 0)
    scroller.add(list_box)
    left.pack_start(scroller, True, True, 0)

    clear_btn = Gtk.Button(label="Clear")
    clear_btn.get_style_context().add_class("abzos-pill")
    clear_btn.connect("clicked", clear_log, list_box)
    left.pack_start(clear_btn, False, False, 0)

    outer.pack_start(left, True, True, 0)
    outer.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 0)

    # Right: calendar
    right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    right.set_size_request(int(PANEL_WIDTH * 0.42), -1)

    heading = Gtk.Label(label=time.strftime("%A\n%B %d %Y"), xalign=0)
    heading.get_style_context().add_class("abzos-heading")
    right.pack_start(heading, False, False, 0)

    cal = Gtk.Calendar()
    cal.get_style_context().add_class("abzos-calendar")
    right.pack_start(cal, False, False, 0)

    today_frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    today_title = Gtk.Label(label="Today", xalign=0)
    today_title.get_style_context().add_class("abzos-title")
    today_frame.pack_start(today_title, False, False, 0)
    today_sub = Gtk.Label(label="No Events", xalign=0)
    today_sub.get_style_context().add_class("abzos-sub")
    today_frame.pack_start(today_sub, False, False, 0)
    right.pack_start(today_frame, False, False, 8)

    outer.pack_start(right, False, False, 0)

    win.show_all()
    position_top_right(win, PANEL_WIDTH + 32)
    win.connect("focus-out-event", lambda w, e: win.close())

    Gtk.main()


if __name__ == "__main__":
    main()
