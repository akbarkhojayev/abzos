#!/usr/bin/env python3
"""Passive notification history logger for abzOS's Notification Center.

This does NOT replace xfce4-notifyd -- it only eavesdrops on the
org.freedesktop.Notifications D-Bus method calls that xfce4-notifyd (or any
other app) already receives, and appends a trimmed record to a local JSON
log. If this script crashes or is missing, real notification popups are
completely unaffected; only the history view loses new entries.
"""
import json
import os
import time

import dbus
import dbus.mainloop.glib
from gi.repository import GLib

LOG_PATH = os.path.expanduser("~/.local/share/abzos/notifications.json")
MAX_ENTRIES = 100


def load_log():
    try:
        with open(LOG_PATH) as f:
            return json.load(f)
    except Exception:
        return []


def save_log(entries):
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    tmp = LOG_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(entries[-MAX_ENTRIES:], f)
    os.replace(tmp, LOG_PATH)


def on_notify(bus, message):
    if message.get_member() != "Notify" or message.get_interface() != "org.freedesktop.Notifications":
        return
    args = message.get_args_list()
    if len(args) < 4:
        return
    app_name, _replaces_id, app_icon, summary, body = (args + [""] * 5)[:5]
    entries = load_log()
    entries.append({
        "app_name": str(app_name) or "System",
        "icon": str(app_icon),
        "summary": str(summary),
        "body": str(body),
        "ts": time.time(),
    })
    save_log(entries)


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    bus.add_match_string_non_blocking(
        "eavesdrop=true,interface='org.freedesktop.Notifications',member='Notify'"
    )
    bus.add_message_filter(on_notify)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
